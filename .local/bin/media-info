#!/bin/bash

default_max_length=32
DISABLE_BROWSER=0
SHOW_PAUSED=0
USE_FALLBACK=0

FALLBACK_TEXT="Too quiet..."
ICON_PAUSED="$(printf '\xef\x81\x8c')"   # nf-fa-pause
ICON_IDLE="$(printf '\xef\x80\x81')"     # nf-fa-music

PLAYERS=("spotify" "Lollypop" "firefox")

ICON_SPOTIFY=""
ICON_LOLLYPOP=""
ICON_FIREFOX=""
ICON_GENERIC=""

for arg in "$@"; do
    case "$arg" in
        max_length=*)
            max_length="${arg#max_length=}"
            ;;
        --no-browser)
            DISABLE_BROWSER=1
            ;;
        --show-paused)
            SHOW_PAUSED=1
            ;;
        --fallback)
            USE_FALLBACK=1
            ;;
    esac
done

max_length="${max_length:-$default_max_length}"

trim_info() {
    local info="$1"
    local max="$2"

    if (( ${#info} > max )); then
        local cut_point=$((max - 3))
        info="${info:0:cut_point}"
        info="$(sed 's/ ✦ *$//; s/✦ *$//; s/[[:space:]]*$//' <<< "$info")…"
    fi
    echo "$info"
}

detect_icon() {
    case "$1" in
        spotify*)   echo "$ICON_SPOTIFY" ;;
        Lollypop*)  echo "$ICON_LOLLYPOP" ;;
        firefox*|org.mpris.MediaPlayer2.firefox*)
                     echo "$ICON_FIREFOX" ;;
        *)          echo "$ICON_GENERIC" ;;
    esac
}

is_browser_player() {
    [[ "$1" == firefox* || "$1" == org.mpris.MediaPlayer2.firefox* ]]
}

output=""
paused=""

# "<icon>  title ✦ artist " for one player
format_player() {
    local player="$1" icon="$2" info
    info="$(playerctl metadata --player="$player" --format '{{title}} ✦ {{artist}}' 2>/dev/null)"
    echo "${icon}  $(trim_info "$info" "$max_length") "
}

# Preferred players first, then everything else playerctl knows about
mapfile -t other_players < <(playerctl --list-players 2>/dev/null)

for player in "${PLAYERS[@]}" "${other_players[@]}"; do
    if (( DISABLE_BROWSER )) && is_browser_player "$player"; then
        continue
    fi

    case "$(playerctl --player="$player" status 2>/dev/null)" in
        Playing)
            output="$(format_player "$player" "$(detect_icon "$player")")"
            break
            ;;
        Paused)
            if (( SHOW_PAUSED )) && [[ -z "$paused" ]]; then
                paused="$(format_player "$player" "$ICON_PAUSED")"
            fi
            ;;
    esac
done

if [[ -n "$output" ]]; then
    echo "$output"
elif [[ -n "$paused" ]]; then
    echo "$paused"
elif (( USE_FALLBACK )); then
    echo "${ICON_IDLE}  ${FALLBACK_TEXT} "
else
    echo ""
fi
