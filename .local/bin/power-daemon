#!/usr/bin/bash
# github.com/pahasara/HyprDots

ICON_PLUGGED="$HOME/.local/share/icons/dunst/plugged.png"
ICON_UNPLUGGED="$HOME/.local/share/icons/dunst/unplugged.png"
ICON_LOW="$HOME/.local/share/icons/dunst/battery-low.png"
ICON_CRITICAL="$HOME/.local/share/icons/dunst/battery-dead.png"
SOUND_CMD="$HOME/.local/bin/sound-alert"

WARN_LOW=25
WARN_CRITICAL=5
CHECK_INTERVAL=10

STATE_FILE="/tmp/power_daemon_state_$USER"
LOCK_FILE="$STATE_FILE.lock"

BAT_PATH=$(echo /sys/class/power_supply/BAT* | cut -d' ' -f1)
[[ ! -d "$BAT_PATH" ]] && { echo "Error: Battery not found"; exit 1; }

# AC adapter name varies by machine (AC, ACAD, ADP1)
AC_FILE=$(ls /sys/class/power_supply/{AC,ACAD,ADP}*/online 2>/dev/null | head -n1)

touch "$STATE_FILE" 2>/dev/null || STATE_FILE="$HOME/.cache/power_daemon_state"
touch "$STATE_FILE" 2>/dev/null

STATUS_FILE="$BAT_PATH/status"
CAPACITY_FILE="$BAT_PATH/capacity"

notify() {
    local msg="$1" icon="$2" urgency="$3" sound_arg="$4"
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID/bus" \
    dunstify -a "system" -u "$urgency" -i "$icon" -r 9991 "Power Manager" "$msg"
    [[ -x "$SOUND_CMD" ]] && $SOUND_CMD "$sound_arg" &>/dev/null &
}

check_power_inner() {
    local status capacity plugged
    local prev_plugged prev_status prev_cap notified_low notified_critical

    read -r status < "$STATUS_FILE" 2>/dev/null || return
    read -r capacity < "$CAPACITY_FILE" 2>/dev/null || return

    # Battery status can read "Not charging" while plugged in, so trust AC state
    if [[ -r "$AC_FILE" ]]; then
        read -r plugged < "$AC_FILE"
    else
        [[ "$status" == "Discharging" ]] && plugged=0 || plugged=1
    fi

    # State file: plugged status capacity notified_low notified_critical
    read -r prev_plugged prev_status prev_cap notified_low notified_critical < "$STATE_FILE" 2>/dev/null
    : "${prev_plugged:=$plugged}" "${prev_status:=$status}" "${notified_low:=0}" "${notified_critical:=0}"

    if [[ "$plugged" != "$prev_plugged" ]]; then
        if [[ "$plugged" == "1" ]]; then
            notify "Charger Connected ($capacity%)" "$ICON_PLUGGED" low "--plugged"
            notified_low=0 notified_critical=0
        else
            notify "Charger Disconnected ($capacity%)" "$ICON_UNPLUGGED" normal "--unplugged"
        fi
    elif [[ "$status" == "Full" && "$prev_status" != "Full" ]]; then
        notify "Battery Charged" "$ICON_PLUGGED" low ""
        notified_low=0 notified_critical=0
    fi

    if [[ "$plugged" == "0" ]]; then
        if (( capacity <= WARN_CRITICAL && notified_critical == 0 )); then
            notify "CRITICAL BATTERY ($capacity%)" "$ICON_CRITICAL" critical "--critical"
            notified_critical=1
        elif (( capacity > WARN_CRITICAL )); then
            notified_critical=0
        fi

        if (( capacity <= WARN_LOW && capacity > WARN_CRITICAL && notified_low == 0 )); then
            notify "Low Battery ($capacity%)" "$ICON_LOW" critical "--low"
            notified_low=1
        elif (( capacity > WARN_LOW )); then
            notified_low=0
        fi
    fi

    printf "%s %s %d %d %d\n" "$plugged" "$status" "$capacity" "$notified_low" "$notified_critical" > "$STATE_FILE" 2>/dev/null
}

# Lock prevents the timer and udev loops from racing and double-notifying
check_power() {
    ( flock 9; check_power_inner ) 9>"$LOCK_FILE"
}

cleanup() {
    [[ -n "$PERIODIC_PID" ]] && kill $PERIODIC_PID 2>/dev/null
    [[ -n "$UDEV_PID" ]] && kill $UDEV_PID 2>/dev/null
    exit 0
}
trap cleanup SIGTERM SIGINT EXIT

check_power

(
    while true; do
        sleep "$CHECK_INTERVAL"
        check_power
    done
) &
PERIODIC_PID=$!

(
    stdbuf -oL udevadm monitor -u -s power_supply | \
    while IFS= read -r line; do
        if [[ "$line" == *"UDEV"*"change"* ]]; then
            sleep 0.3   # sysfs can lag behind the udev event
            check_power
        fi
    done
) &
UDEV_PID=$!

wait
