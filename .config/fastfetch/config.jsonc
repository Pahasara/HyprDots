{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Pictures/Assets/fetch.png",
        "padding": {
            "top": 2,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ",
        "size": {
            "binaryPrefix": "iec"
        }
    },
    "modules": [
        "break",
        "break",
        // {
        //     "type": "title",
        //     "key": " ",
        //     "keyColor": "36"
        // },
        {
            "type": "command",
            "key": " ",
            "text": "d=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); u=$(cut -d. -f1 /proc/uptime); h=$(( (u % 86400) / 3600 )); m=$(( (u % 3600) / 60 )); printf \"\\033[1;36m%s\\033[0m@\\033[1;36m%s\\033[0m \\033[37m[%d-%d:%02d]\\033[0m\\n\" \"$(whoami)\" \"$(uname -n)\" \"$d\" \"$h\" \"$m\""
        },
        {
            "type": "custom",
            "format": "\u001b[31m-----------"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "32"
        },
        {
            "type": "custom",
            "format": "\u001b[32m------------------------"
        },
        {
            "type": "command",
            "key": "󰦱 ",
            "keyColor": "38",
            "text": "$SCRIPT_DIR/gpu-info"
        },
        {
            "type": "command",
            "key": " ",
            "keyColor": "35",
            "text": "$SCRIPT_DIR/dev-info"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "34"
        },
        // {
        //     "type": "uptime",
        //     "key": " ",
        //     "keyColor": "34"
        // },
        // {
        //     "type": "command",
        //     "key": "󱦟 ",
        //     "keyColor": "37",
        //     "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        // },
        {
            "type": "command",
            "key": " ",
            "keyColor": "93",
            "text": "$SCRIPT_DIR/shader-info"
        },
        {
            "type": "custom",
            "format": "\u001b[32m------------------------"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "32"
        },
        {
            "type": "gpu",
            "key": " ",
            "keyColor": "36"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "31"
        },
        {
            "type": "disk",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "custom",
            "format": "\u001b[31m────────────"
        },
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m "
        }
    ]
}
